# SSH config cho cụm 4 node AWS EC2
Host *
    User ubuntu
    IdentityFile "C:\Users\THIS PC\Downloads\lb-aws.pem"
    IdentityFile ~/.ssh/lb-aws.pem
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking accept-new
    ConnectTimeout 10

Host node1 lb-new-node1 3.25.139.183
    HostName 3.25.139.183

Host node2 lb-new-node2 3.26.2.87
    HostName 3.26.2.87

Host node3 lb-new-node3 15.135.223.24
    HostName 15.135.223.24

Host node4 lb-new-node4 3.107.13.147
    HostName 3.107.13.147
