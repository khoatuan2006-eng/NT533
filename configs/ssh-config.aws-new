# SSH config cho cụm 4 node AWS EC2
Host *
    User ubuntu
    IdentityFile "C:\Users\THIS PC\Downloads\lb-aws.pem"
    IdentityFile ~/.ssh/lb-aws.pem
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking accept-new
    ConnectTimeout 10

Host node1 lb-new-node1 3.27.239.78
    HostName 3.27.239.78

Host node2 lb-new-node2 13.239.63.219
    HostName 13.239.63.219

Host node3 lb-new-node3 3.27.243.249
    HostName 3.27.243.249

Host node4 lb-new-node4 3.27.108.199
    HostName 3.27.108.199
