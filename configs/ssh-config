# SSH tới ba VM trên cloud UIT-IoT. Dùng chung cho cả nhóm, không cần sửa:
# mỗi người chỉ cần đặt file khóa của nhóm vào ~/.ssh/uitiot-lab.pem
# (Windows: C:\Users\<tên>\.ssh\uitiot-lab.pem) và bật VPN UIT-IoT.
Host *
    User ubuntu
    IdentityFile ~/.ssh/uitiot-lab.pem
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking accept-new
    ConnectTimeout 8

# node1 có IP công khai trong mạng VPN và là cổng vào cho hai node còn lại.
Host lb-node1 192.168.121.214
    HostName 192.168.121.214

Host 192.168.1.172 192.168.1.217
    ProxyJump lb-node1
