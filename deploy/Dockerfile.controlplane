FROM python:3.12-slim AS dependencies
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
RUN python -c "import subprocess, sys, tomllib; project = tomllib.load(open('pyproject.toml', 'rb'))['project']; subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir', *project['dependencies']])"

FROM dependencies AS packaged
COPY README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir --no-deps --prefix=/package .

FROM packaged AS tested
ENV PYTHONPATH=/package/lib/python3.12/site-packages
RUN python -c "import subprocess, sys, tomllib; project = tomllib.load(open('pyproject.toml', 'rb'))['project']; subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir', *project['optional-dependencies']['dev']])"
COPY tests/ ./tests/
RUN python -m pytest -q tests/test_controlplane*.py && touch /tmp/controlplane-tested

FROM dependencies
COPY --from=packaged /package/ /usr/local/
COPY --from=tested /tmp/controlplane-tested /app/.controlplane-tested
USER 65534:65534
EXPOSE 18000
ENTRYPOINT ["grpc-lb-controlplane"]
